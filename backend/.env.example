# Copy to .env and adjust. Never commit .env.
PORT=8080
# 0.0.0.0 lets phones on the same Wi-Fi reach the API at http://<your-PC-IP>:8080
HOST=0.0.0.0

# Admin connection: creates databases and runs migrations (a PostgreSQL superuser).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# App connection: a normal role, so row-level security isolates each customer's data.
DATABASE_URL=postgres://progen_app:progen_app@localhost:5432/progen
# Used only by `npm test`.
TEST_DATABASE_URL=postgres://progen_app:progen_app@localhost:5432/progen_test

# At least 32 random characters in production.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed web origins, or * during development.
CORS_ORIGINS=*
# Folder for uploaded photos and documents (default: backend/uploads). Back it up with the database.
# UPLOAD_DIR=/var/lib/progen/uploads
