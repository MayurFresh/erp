# Copy to .env and adjust. Never commit .env.
PORT=8080
# 0.0.0.0 lets phones on the same Wi-Fi reach the API at http://<your-PC-IP>:8080
HOST=0.0.0.0

# Admin connection: creates databases and runs migrations (a PostgreSQL superuser).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# App connection: a normal role, so row-level security isolates each customer's data.
DATABASE_URL=postgres://progen_app:progen_app@localhost:5432/progen
# Used only by `npm test`.
TEST_DATABASE_URL=postgres://progen_app:progen_app@localhost:5432/progen_test

# At least 32 random characters in production.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed web origins, or * during development.
# Production: CORS_ORIGINS=https://app.onematrix.site
CORS_ORIGINS=*
# Folder for uploaded photos and documents (default: backend/uploads). Back it up with the database.
# UPLOAD_DIR=/var/lib/onematrix/uploads

# production makes CORS_ORIGINS=* and a missing DATA_KEY startup errors.
# NODE_ENV=development
# 32 random bytes, base64 (openssl rand -base64 32). Seals TOTP, SSO and GSP secrets. Required in production.
# DATA_KEY=
# Set only behind a reverse proxy: true, a hop count (1) or the proxy addresses. Default false.
# TRUST_PROXY=1
# Requests per IP per minute on every route except sign-in (own limits) and /health.
# RATE_LIMIT_PER_MINUTE=600
# SSO issuers on private or loopback addresses: allowed outside production unless set to false.
# SSO_ALLOW_PRIVATE_ISSUERS=false
# WEBHOOK_ALLOW_PRIVATE=false
# OTEL_ENABLED=false

# Production settings (leave empty in development)
# 32+ random characters; seals stored channel credentials. Without it a key is derived from JWT_SECRET.
# DATA_KEY=
# Public addresses used in emails, links and webhook URLs
# APP_URL=https://app.onematrix.site
# PUBLIC_API_URL=https://api.onematrix.site
# Email: EMAIL_DRIVER=smtp with SMTP_URL=smtps://user:pass@host:465 to send invoices and reminders
# EMAIL_DRIVER=smtp
# EMAIL_FROM=OneMatrix <no-reply@onematrix.site>
# SMTP_URL=
# WhatsApp Business Cloud API, for sending invoices and reminders on WhatsApp
# WHATSAPP_DRIVER=cloud_api
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
# Tracing: set to an OTLP collector address to turn it on
# OTEL_EXPORTER_OTLP_ENDPOINT=
# SMS: SMS_DRIVER=msg91 (flow API, needs SMS_AUTH_KEY) or http (any provider with a JSON POST). Default log.
# India needs DLT: the company's entity id and a template id per message are set in Settings, SMS.
# SMS_DRIVER=msg91
# SMS_AUTH_KEY=
# SMS_SENDER_ID=
# SMS_HTTP_URL=
# SMS_HTTP_HEADERS={"Authorization":"Bearer ..."}
# SMS_HTTP_BODY={"to":"{to}","message":"{message}","sender":"{sender}","entity":"{entityId}","template":"{templateId}"}
